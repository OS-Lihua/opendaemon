# Local daemon bind.
OPENDAEMON_DAEMON_HOST=127.0.0.1
OPENDAEMON_DAEMON_PORT=19514

# Local operator token for Console bootstrap login and product setup.
OPENDAEMON_BOOTSTRAP_TOKEN=replace-with-a-random-local-token

# Optional control-plane integration.
# OPENDAEMON_CONTROL_PLANE_URL=
# OPENDAEMON_CONTROL_PLANE_ENROLLMENT_SECRET=

# Optional provider runtime overrides.
# OPENDAEMON_PROVIDER_CODEX_PATH=

# Optional logging.
RUST_LOG=info
