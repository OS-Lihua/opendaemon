            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "env_allowlist": {
          "items": {
            "type": "string"
          },
          "type": "array"
